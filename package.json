{
  "name": "dashboard-v2",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @dashboard/shared && npm run build -w @dashboard/client",
    "typecheck": "npm run build -w @dashboard/shared && npm run typecheck --workspaces --if-present && tsc -p tsconfig.json --noEmit",
    "test": "npm run build -w @dashboard/shared && npm run test --workspaces --if-present",
    "dev": "npm run dev -w @dashboard/server",
    "dev:api": "npm run dev -w @dashboard/server",
    "dev:web": "npm run dev -w @dashboard/client",
    "dev:web:lan": "npm run dev -w @dashboard/client -- --host",
    "migrate": "npm run migrate -w @dashboard/server",
    "import-v1": "tsx server/src/db/importV1.ts",
    "verify-v1": "tsx server/src/db/verifyV1.ts",
    "drift": "tsx server/src/db/driftReport.ts",
    "delta-v1": "tsx server/src/db/deltaV1.ts",
    "check-v1": "tsx server/src/db/importV1.checks.ts",
    "import-cofid": "tsx server/src/db/importCofid.ts",
    "import-workouts": "tsx server/src/db/importWorkouts.ts"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
