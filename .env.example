# ---------------------------------------------------------------------------
# Database. Any Postgres 13+; production runs on Supabase, whose URLs are shown.
# Locally all three URLs can be the same plain one, for example
#   postgresql://postgres:postgres@localhost:5432/dashboard
# Supabase project ref: <project-ref> (Project Settings → General).
# ---------------------------------------------------------------------------

# Runtime: TRANSACTION pooler, port 6543.
# Connection state does not survive between statements here, which is why every
# runtime query is schema-qualified via `T` in server/src/config.ts.
DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-<n>-<region>.pooler.supabase.com:6543/postgres

# Tests. Points at the same database; the app_test schema keeps them isolated.
TEST_DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-<n>-<region>.pooler.supabase.com:6543/postgres

# Migrations: SESSION pooler, port 5432.
# Session mode holds one backend for the whole connection, so SET search_path
# persists and the migration DDL can stay unqualified.
# NOT db.<project-ref>.supabase.co:5432 — the true direct endpoint is
# IPv6-only without the IPv4 add-on and will fail from IPv4-only networks and CI.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:PASSWORD@aws-<n>-<region>.pooler.supabase.com:5432/postgres

# app       = production (and what Vercel uses)
# app_dev   = your local development copy, so an experiment can't touch
#             production data in the same database
# app_test  = the test suite; server/tests/setup.ts refuses any other value
DB_SCHEMA=app_dev

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No fallback value exists in code — a missing secret fails startup on purpose.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email (password reset). Optional — with no key the reset link is logged
# to the console instead of sent, which is fine for local development.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Dashboard <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3001

# Who may register. Unset or empty = nobody new, which is what production
# relies on. "*" = anyone: local development only, for throwaway accounts.
# Or a comma-separated list of addresses, e.g. to create a demo account.
SIGNUP_ALLOWLIST=*
