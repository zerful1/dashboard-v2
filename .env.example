# ---------------------------------------------------------------------------
# Database — the SAME Supabase project as the v1 dashboard.
# v2 lives in the `app` schema; v1's tables stay untouched in `public`.
# Project ref: mogkpxzwwcbmdvtsince
# ---------------------------------------------------------------------------

# Runtime: TRANSACTION pooler, port 6543.
# Connection state does not survive between statements here, which is why every
# runtime query is schema-qualified via `T` in server/src/config.ts.
DATABASE_URL=postgresql://postgres.mogkpxzwwcbmdvtsince:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Tests. Points at the same database; the app_test schema keeps them isolated.
TEST_DATABASE_URL=postgresql://postgres.mogkpxzwwcbmdvtsince:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres

# Migrations: SESSION pooler, port 5432.
# Session mode holds one backend for the whole connection, so SET search_path
# persists and the migration DDL can stay unqualified.
# NOT db.mogkpxzwwcbmdvtsince.supabase.co:5432 — the true direct endpoint is
# IPv6-only without the IPv4 add-on and will fail from IPv4-only networks and CI.
MIGRATION_DATABASE_URL=postgresql://postgres.mogkpxzwwcbmdvtsince:PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

DB_SCHEMA=app

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# 32+ random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# No fallback value exists in code — a missing secret fails startup on purpose.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Email (password reset). Optional — with no key the reset link is logged
# to the console instead of sent, which is fine for local development.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=Dashboard <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3001
